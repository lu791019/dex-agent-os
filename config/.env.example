# Dex Agent OS - 環境變數範本
# 複製此檔為 .env 並填入實際值

# WordPress REST API
WP_URL=https://your-site.com
WP_USERNAME=
WP_APP_PASSWORD=

# Discord Bot (future)
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# Notion (future)
# NOTION_TOKEN=
# NOTION_DATABASE_ID=

# Threads API（從 Meta Developer Dashboard「用戶權杖產生器」取得）
THREADS_ACCESS_TOKEN=

# Notion — Podwise 串接（podcast-add --notion）
# 1. https://www.notion.so/my-integrations → 建立 Integration → 複製 Secret
# 2. 在 Podwise 匯出的 Notion database → "..." → "Connect to" → 選 Integration
# 3. 複製 database URL 中的 32 碼 ID
# NOTION_TOKEN=secret_xxxxxxxxxxxx
# NOTION_PODWISE_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Readwise — Podwise 串接（podcast-add --readwise）
# https://readwise.io/access_token → 複製 token
# READWISE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fireflies.ai — 會議逐字稿 API（fireflies-sync）
# 需 Business plan（$19/月）才有 API 權限
# https://app.fireflies.ai/integrations/custom/fireflies → 複製 API Key
# FIREFLIES_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets — Reader 週報輸出
# 1. 在 Google Sheets 建立空白試算表
# 2. 複製 URL 中的 spreadsheet ID（/d/ 和 /edit 之間的字串）
# GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多 Repo 工作日誌追蹤 — L1 工作日誌會掃描這些 repo 的 git log
# 逗號分隔的絕對路徑，未設定時只掃 dex-agent-os 本身
# WORK_REPOS=/Users/dex/dex-agent-os,/Users/dex/some-work-project,/Users/dex/another-repo
